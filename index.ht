<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Dexter Code</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background: #0b0b0f;
      color: white;
      min-height: 100vh;
    }

    header {
      background: #111118;
      padding: 20px;
      text-align: center;
      border-bottom: 1px solid #252535;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .logo {
      font-size: 28px;
      font-weight: bold;
      color: #ffffff;
    }

    .subtitle {
      color: #888899;
      margin-top: 5px;
      font-size: 14px;
    }

    .container {
      width: 92%;
      max-width: 1100px;
      margin: 25px auto;
    }

    .search {
      width: 100%;
      padding: 15px;
      border-radius: 12px;
      border: 1px solid #29293a;
      background: #15151e;
      color: white;
      outline: none;
      margin-bottom: 25px;
      font-size: 16px;
    }

    .search:focus {
      border-color: #5865f2;
    }

    .files {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }

    .card {
      background: #15151e;
      border: 1px solid #252535;
      border-radius: 16px;
      overflow: hidden;
      transition: 0.2s;
    }

    .card:hover {
      transform: translateY(-3px);
      border-color: #5865f2;
    }

    .card img {
      width: 100%;
      height: 170px;
      object-fit: cover;
      display: block;
      background: #20202b;
    }

    .card-content {
      padding: 16px;
    }

    .card h2 {
      font-size: 19px;
      margin-bottom: 8px;
    }

    .card p {
      color: #9999aa;
      font-size: 14px;
      line-height: 1.5;
      min-height: 42px;
    }

    .category {
      display: inline-block;
      margin: 12px 0;
      padding: 5px 9px;
      background: #25253a;
      color: #aeb4ff;
      border-radius: 8px;
      font-size: 12px;
    }

    .download {
      display: block;
      width: 100%;
      border: none;
      padding: 12px;
      border-radius: 10px;
      background: #5865f2;
      color: white;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
      text-align: center;
    }

    .download:hover {
      background: #4752c4;
    }

    .empty {
      text-align: center;
      color: #777788;
      padding: 50px 10px;
      grid-column: 1 / -1;
    }

    footer {
      text-align: center;
      color: #666677;
      padding: 35px 10px;
      font-size: 13px;
    }
  </style>
</head>

<body>

  <header>
    <div class="logo">DEXTER CODE</div>
    <div class="subtitle">Mods • Apps • Archivos</div>
  </header>

  <main class="container">

    <input
      type="text"
      id="search"
      class="search"
      placeholder="🔎 Buscar archivos..."
    >

    <section id="files" class="files">
      <div class="empty">
        Cargando archivos...
      </div>
    </section>

  </main>

  <footer>
    © 2026 Dexter Code
  </footer>

  <script>
    /*
      Más adelante conectaremos aquí Supabase.
      Por ahora la página está preparada para recibir
      los archivos publicados desde nuestra base de datos.
    */

    const filesContainer = document.getElementById("files");
    const searchInput = document.getElementById("search");

    let files = [];

    function showFiles(list) {

      filesContainer.innerHTML = "";

      if (list.length === 0) {
        filesContainer.innerHTML = `
          <div class="empty">
            No hay archivos publicados todavía.
          </div>
        `;
        return;
      }

      list.forEach(file => {

        const card = document.createElement("article");

        card.className = "card";

        card.innerHTML = `
          <img
            src="${file.image_url || 'https://placehold.co/600x400/15151e/ffffff?text=Dexter+Code'}"
            alt="${file.name}"
          >

          <div class="card-content">

            <h2>${file.name}</h2>

            <p>
              ${file.description || "Sin descripción"}
            </p>

            <span class="category">
              ${file.category || "Archivo"}
            </span>

            <a
              class="download"
              href="${file.file_url}"
              target="_blank"
              rel="noopener"
            >
              ⬇️ Descargar
            </a>

          </div>
        `;

        filesContainer.appendChild(card);
      });
    }

    searchInput.addEventListener("input", () => {

      const search = searchInput.value.toLowerCase();

      const filtered = files.filter(file =>
        file.name.toLowerCase().includes(search) ||
        (file.description || "").toLowerCase().includes(search) ||
        (file.category || "").toLowerCase().includes(search)
      );

      showFiles(filtered);
    });

    showFiles(files);
  </script>

</body>
</html>
